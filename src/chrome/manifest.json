{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "1.4.9",
  "description": "__MSG_extDescription__",
  "author": "wudao",
  "minimum_chrome_version": "116",
  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "manager.html"
  },
  "action": {
    "default_title": "__MSG_extActionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "__MSG_cmdToggleSidebar__"
    },
    "open-in-new-tab": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "__MSG_cmdOpenInNewTab__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://icon.horse/*",
    "https://favicon.yandex.net/*",
    "https://icons.duckduckgo.com/*",
    "https://www.google.com/*",
    "https://api.iowen.cn/*",
    "file:///*"
  ]
}